# ── JWT ──────────────────────────────────────────────────────────────────────
# This API's own signing secret. It is NOT tied to Supabase: the Edge Function
# authenticates the user itself, then calls this API with a service token
# signed with this secret. Generate one with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mint the Edge Function's token with scripts/make_service_token.py.
JWT_SECRET=generate_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser, or *
ALLOWED_ORIGINS=*
DEBUG=false
